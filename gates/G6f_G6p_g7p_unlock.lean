-- ================================================================
-- §4 G7′ 解锁定理（κ 判据·G7p.lean 定义沿·交叉相乘 Nat 落地）
-- ================================================================

abbrev kappaZeroIdx (a b m n nL nH : Nat) : Prop :=
  a * (m * nL + n * nH) = m * nL * (a + b)

/-- κ ≤ 1/t（t=10 注册阈·t=50 紧界 0.02） -/
abbrev kappaLeT (a b m n nL nH t : Nat) : Prop :=
  t * a * (m * nL + n * nH) ≤ (a + b) * (m * nL + n * nH) + t * (m * nL) * (a + b)

/-- κ ≥ −1/t -/
abbrev kappaGeT (a b m n nL nH t : Nat) : Prop :=
  t * (m * nL) * (a + b) ≤ (a + b) * (m * nL + n * nH) + t * a * (m * nL + n * nH)

/-- A 主胞（a=648 b=0 m=2592 n=0）：κ=0（独立性方程恒等） -/
theorem g6f_amain_kappa_zero : kappaZeroIdx 648 0 2592 0 13 19 := by decide

/-- 退化通式：n=0 时 κ≡0 恒成立（零对照信息量·判读须附机制位证据） -/
theorem kappa_zero_of_n_zero (a m nL nH : Nat) :
    kappaZeroIdx a 0 m 0 nL nH := by
  unfold kappaZeroIdx
  simp [Nat.mul_add, Nat.add_mul, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm]

/-- A 主胞机制位锚：支撑集 K_h 密度 3/12 ＝ 机会位 32/128（恰合） -/
theorem g6f_amain_support_chance : 3 * 128 = 32 * 12 := by decide

/-- KIMI（a=301 b=63 m=1240 n=200）：κ=+229/12948≈+0.0177·四定理机证 -/
theorem g6f_kimi_kappa_le_tenth : kappaLeT 301 63 1240 200 13 19 10 := by decide
theorem g6f_kimi_kappa_ge_ntenth : kappaGeT 301 63 1240 200 13 19 10 := by decide
theorem g6f_kimi_kappa_le_fiftieth : kappaLeT 301 63 1240 200 13 19 50 := by decide
theorem g6f_kimi_kappa_ge_nfiftieth : kappaGeT 301 63 1240 200 13 19 50 := by decide

/-- KIMI B 归一差红：−0.2 ≤ B_norm ≤ −0.1（|B_norm|>0.10 副判据超阈·
    640·a·n·nH ≥ n·nH·X＋640·b·X ⟺ B_norm ≤ −1/10） -/
theorem g6f_kimi_bnorm_le_ntenth :
    640 * 301 * (200 * 19) ≥ 200 * 19 * (1240 * 13) + 640 * 63 * (1240 * 13) := by decide
theorem g6f_kimi_bnorm_ge_nfifth :
    320 * 301 * (200 * 19) ≤ 200 * 19 * (1240 * 13) + 320 * 63 * (1240 * 13) := by decide

/-- KIMI B 原始差过（贴阈）：b/n − a/m ≤ 1/10 -/
theorem g6f_kimi_braw_le_tenth :
    10 * 63 * 1240 ≤ 200 * 1240 + 10 * 301 * 200 := by decide

