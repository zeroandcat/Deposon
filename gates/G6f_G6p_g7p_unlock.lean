-- §3 G6′ 门定理（各段独立·distinct_min ≥ 11 ∧ repeat_rate ≤ 5%）
-- ================================================================

theorem g6f_G6p_amain_form :
    (dataAForm.all callOK) = true ∧ totalRep dataAForm * 20 ≤ totalOps dataAForm := by decide

theorem g6f_G6p_amain_wd :
    (dataAWd.all callOK) = true ∧ totalRep dataAWd * 20 ≤ totalOps dataAWd := by decide

theorem g6f_G6p_amain_dv :
    (dataADv.all callOK) = true ∧ totalRep dataADv * 20 ≤ totalOps dataADv := by decide

theorem g6f_G6p_kimi :
    (dataK.all callOK) = true ∧ totalRep dataK * 20 ≤ totalOps dataK := by decide

/-- A 主胞 call 结构锚：{k0..k11} 恰 12 键全 distinct（216/216 calls 同构） -/
