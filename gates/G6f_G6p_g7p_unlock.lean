-- §1 G6′ 门定义（预注册口径·P0' 认证操作化沿：distinct_min ≥ 11）
-- ================================================================

def dedup : List Nat → List Nat
  | [] => []
  | x :: xs => let r := dedup xs; if r.contains x then r else x :: r

def callOK (c : List Nat) : Bool := 11 ≤ (dedup c).length

/-- 链内重复 op 数（同 call 内重复键数）＋总 op 数（repeat_rate 分子分母） -/
def repOps (c : List Nat) : Nat := c.length - (dedup c).length
def totalRep (D : List (List Nat)) : Nat := D.foldl (fun acc c => acc + repOps c) 0
def totalOps (D : List (List Nat)) : Nat := D.foldl (fun acc c => acc + c.length) 0

