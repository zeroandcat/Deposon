"""
Stage 1 (fixed): 9 model × 30 cells T/R/A decomposition with per-schema detection
0 LLM, pure numpy + existing data only
"""
import json
import os
import numpy as np
import hashlib

WORKSPACE = r'D:\私人资料\deposon-repo'
RESULTS_DIR = os.path.join(WORKSPACE, 'results')
ANCHOR_SHA12 = "03c6c01f3697"

def load_json(path):
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)

wa = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_worker_a_2026_09_10.json'))
wb = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_worker_b_2026_09_10.json'))
wc = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_worker_c_2026_09_10.json'))
wd = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_worker_d_2026_09_10.json'))
nine = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_9model_30cells_2026_09_10.json'))
mm3 = load_json(os.path.join(RESULTS_DIR, 'deposon_volcengine_minimax_m3_30cells_2026_09_10.json'))

# Per-schema T/R/A classifiers

def tra_worker_a(cells):
    """Worker A schema: 'passed' boolean + 'pred' string + 'error' string"""
    T, R, A = 0, 0, 0
    timeout_count = 0
    parse_fail = 0
    wrong_answer = 0
    for c in cells:
        if c.get('passed'):
            T += 1
            continue
        # Not passed: distinguish R (wrong) vs A (timeout/parse-fail)
        err = c.get('error') or ''
        pred = c.get('pred')
        if 'Timeout' in str(err) or pred is None:
            A += 1
            if 'Timeout' in str(err):
                timeout_count += 1
            if pred is None:
                parse_fail += 1
        else:
            R += 1
            wrong_answer += 1
    return {
        'T': T, 'R': R, 'A': A,
        'T_frac': T / len(cells),
        'R_frac': R / len(cells),
        'A_frac': A / len(cells),
        'timeout_count': timeout_count,
        'parse_fail_count': parse_fail,
        'wrong_answer_count': wrong_answer,
        'n': len(cells),
        'schema': 'worker_a',
    }

def tra_worker_bc(cells):
    """Worker B/C schema: 'is_correct' boolean + 'llm_extracted' float + 'error' string + 'note' string"""
    T, R, A = 0, 0, 0
    timeout_count = 0
    parse_fail = 0
    wrong_answer = 0
    for c in cells:
        if c.get('is_correct'):
            T += 1
            continue
        err = c.get('error') or ''
        ext = c.get('llm_extracted')
        note = c.get('note') or ''
        http = c.get('http_status', 0)
        # A (dissipated): timeout/parse-fail/no answer
        if 'Timeout' in str(err) or ext is None or note == 'http_-1' or note == 'timeout_30s' or http == -1:
            A += 1
            if 'Timeout' in str(err):
                timeout_count += 1
            if ext is None:
                parse_fail += 1
        else:
            R += 1
            wrong_answer += 1
    return {
        'T': T, 'R': R, 'A': A,
        'T_frac': T / len(cells),
        'R_frac': R / len(cells),
        'A_frac': A / len(cells),
        'timeout_count': timeout_count,
        'parse_fail_count': parse_fail,
        'wrong_answer_count': wrong_answer,
        'n': len(cells),
        'schema': 'worker_bc',
    }

def tra_worker_d(cells):
    """Worker D schema: 'passed' boolean + 'pred' string + 'err' string + 'content' string"""
    T, R, A = 0, 0, 0
    timeout_count = 0
    parse_fail = 0
    wrong_answer = 0
    for c in cells:
        if c.get('passed'):
            T += 1
            continue
        err = c.get('err') or ''
        pred = c.get('pred')
        content = c.get('content') or ''
        # A: timeout / empty / no content
        if 'Timeout' in str(err) or 'timed out' in str(err) or (pred is None and not content):
            A += 1
            if 'Timeout' in str(err) or 'timed out' in str(err):
                timeout_count += 1
            if pred is None and not content:
                parse_fail += 1
        else:
            R += 1
            wrong_answer += 1
    return {
        'T': T, 'R': R, 'A': A,
        'T_frac': T / len(cells),
        'R_frac': R / len(cells),
        'A_frac': A / len(cells),
        'timeout_count': timeout_count,
        'parse_fail_count': parse_fail,
        'wrong_answer_count': wrong_answer,
        'n': len(cells),
        'schema': 'worker_d',
    }

def tra_minimax_standalone(cells):
    """minimax-m3 standalone: same as B/C (is_correct + llm_extracted)"""
    return tra_worker_bc(cells)

# Build per-model cells + classification
per_model_cells = {}
per_model_schema = {}

# Worker A
for m in wa['models']:
    name = m['model']
    if name in wa.get('detailed', {}):
        cells = wa['detailed'][name]['gsm8k'] + wa['detailed'][name]['strategyqa']
        per_model_cells[name] = cells
        per_model_schema[name] = 'worker_a'

# Worker B
for m in wb['models']:
    name = m['model']
    per_model_cells[name] = m.get('cells', [])
    per_model_schema[name] = 'worker_bc'

# Worker C
for m in wc['models']:
    name = m['model']
    per_model_cells[name] = m.get('cells', [])
    per_model_schema[name] = 'worker_bc'

# Worker D
for m in wd['models']:
    name = m['model']
    per_model_cells[name] = m.get('cells', [])
    per_model_schema[name] = 'worker_d'

# minimax-m3 standalone (richer than worker_a's minimax-m3 detail)
per_model_cells['minimax-m3'] = mm3['cells']
per_model_schema['minimax-m3'] = 'minimax_standalone'

# Apply classifier
def classify(name, cells, schema):
    if schema == 'worker_a':
        return tra_worker_a(cells)
    elif schema == 'worker_bc':
        return tra_worker_bc(cells)
    elif schema == 'worker_d':
        return tra_worker_d(cells)
    elif schema == 'minimax_standalone':
        return tra_minimax_standalone(cells)
    return None

models_tra = {}
for name, cells in per_model_cells.items():
    if cells and len(cells) == 30:
        tra = classify(name, cells, per_model_schema[name])
        if tra:
            models_tra[name] = tra

# Add doubao-seed-2.0-lite from 9model aggregate (1 GSM + 3 STQ wrong answer, no timeouts)
# Source: VOLCENGINE_9MODEL_30CELLS_2026_09_10.md §3
# GSM#07: 36.0→11.0 (wrong), STQ#05 (Yes→No), STQ#07 (No→Yes), STQ#10 (No→Yes)
# All 4 fails are wrong-answer (R=4, A=0)
models_tra['doubao-seed-2.0-lite'] = {
    'T': 26, 'R': 4, 'A': 0,
    'T_frac': 26/30, 'R_frac': 4/30, 'A_frac': 0/30,
    'timeout_count': 0, 'parse_fail_count': 0, 'wrong_answer_count': 4,
    'n': 30,
    'schema': '9model_aggregate',
    'note': 'R/A split from 9model §3 detailed log: all 4 fails are wrong-answer (no timeout/parse-fail)'
}

# Print breakdown
print("=== 9-model T/R/A breakdown (FIXED) ===")
for name, tra in sorted(models_tra.items(), key=lambda x: -x[1]['T_frac']):
    s = tra.get('schema', '?')
    print(f"  {name:30s} [{s:18s}]  T={tra['T']:2d}({tra['T_frac']:.3f})  R={tra['R']:2d}({tra['R_frac']:.3f})  A={tra['A']:2d}({tra['A_frac']:.3f})  T+R+A={tra['T']+tra['R']+tra['A']}/30")

# ---- 3. Game theory metrics for 5 candidates P-A/B/C/D ----
names_sorted = sorted(models_tra.keys())
T_arr = np.array([models_tra[m]['T_frac'] for m in names_sorted])
R_arr = np.array([models_tra[m]['R_frac'] for m in names_sorted])
A_arr = np.array([models_tra[m]['A_frac'] for m in names_sorted])

# P-A: 26-cell equilibrium band
equilibrium_band = (T_arr >= 0.80) & (T_arr <= 0.90)
n_equilibrium = int(equilibrium_band.sum())
n_above = int((T_arr > 0.90).sum())
n_below = int((T_arr < 0.80).sum())

# P-B: T+R+A=1 residual
conservation_residuals = T_arr + R_arr + A_arr - 1.0
max_residual = float(np.max(np.abs(conservation_residuals)))

# P-C: A_frac (distortion bound) per model
A_max_idx = int(A_arr.argmax())
A_min_idx = int(A_arr.argmin())

# P-D: 3 root fingerprints
PD_FINGERPRINTS = {
    'P-D V0.1 main': '7d6d3d39fad8',
    'PD2 reproduction': 'f88d855aaf83',
    'EIS reproduction': 'e66e44e63f5a',
}
PD_5_ANCHORS = {
    'P_A_ECR_BASELINE': 'bd1caab42b4c',
    'P_B_DISTORTION_BOUND': 'd3f0c4d2d7c5',
    'P_C_TWO_PHASE_STRUCTURE': '87e2b9f0e3a1',
    'P_D_FINGERPRINT': '6f1c2e8a4b9d',
    'P_E_DOUBAN_EMBEDDING': 'c4a7d3e6f2b8',
}

# P-E: 3D T+R+A distance from (1,0,0)
ideal = np.array([1.0, 0.0, 0.0])
distances = []
for m in names_sorted:
    p = np.array([models_tra[m]['T_frac'], models_tra[m]['R_frac'], models_tra[m]['A_frac']])
    d = float(np.linalg.norm(p - ideal))
    distances.append(d)
distances = np.array(distances)

# v3 §6 Feshbach-style scattering analysis
# A model is "scattering-stable" if A_frac is small (low dissipative loss)
# "T_dominant" means T_frac > 0.5
t_dominant = T_arr > 0.5
n_t_dominant = int(t_dominant.sum())

# Cross-model correlation between T and A
# If T_frac and A_frac anti-correlate, A acts as a "loss" channel
corr_TA = float(np.corrcoef(T_arr, A_arr)[0, 1]) if T_arr.std() > 0 and A_arr.std() > 0 else None
corr_TR = float(np.corrcoef(T_arr, R_arr)[0, 1]) if T_arr.std() > 0 and R_arr.std() > 0 else None

# Build comprehensive game theory evaluation
game_theory_eval = {
    'meta': {
        'timestamp': '2026-09-10T21:50:00+08:00',
