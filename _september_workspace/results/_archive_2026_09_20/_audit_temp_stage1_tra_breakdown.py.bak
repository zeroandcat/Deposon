# Compute output JSON SHA-12
out_path = os.path.join(RESULTS_DIR, 'deposon_game_theory_eval_2026_09_10.json')
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(game_theory_eval, f, ensure_ascii=False, indent=2)
with open(out_path, 'rb') as f:
    out_sha = hashlib.sha256(f.read()).hexdigest()[:12]
print(f"\nWrote {out_path}")
print(f"OUT JSON SHA-12: {out_sha}")

print("\n=== 5 candidates verdict ===")
for c, v in game_theory_eval['5_candidates_evaluation'].items():
    print(f"  {c}: {v['verdict']}")
print(f"\nBest by T: {game_theory_eval['overall_verdict']['best_models_by_T_frac']}")
print(f"Best by A: {game_theory_eval['overall_verdict']['best_models_by_A_frac']}")
